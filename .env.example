# Database
DATABASE_URL="postgresql://username:password@localhost:5432/digital_shop"

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Admin credentials (for initial setup)
ADMIN_EMAIL="admin@digitalshop.vn"
ADMIN_PASSWORD="Admin@123456"
ADMIN_NAME="Admin"

# App settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SHOP_NAME="DigiShop"
NEXT_PUBLIC_SHOP_PHONE="0901234567"
NEXT_PUBLIC_SHOP_EMAIL="support@digitalshop.vn"

# Bank payment info
NEXT_PUBLIC_BANK_NAME="MB Bank"
NEXT_PUBLIC_BANK_ACCOUNT="0901234567"
NEXT_PUBLIC_BANK_HOLDER="NGUYEN VAN A"

# VietQR API (free)
NEXT_PUBLIC_VIETQR_BANK_ID="MB"
NEXT_PUBLIC_VIETQR_ACCOUNT_NO="0901234567"
NEXT_PUBLIC_VIETQR_ACCOUNT_NAME="NGUYEN VAN A"

# Node environment
NODE_ENV="development"
